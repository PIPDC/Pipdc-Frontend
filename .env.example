# PIPDC API base URL.
# Development (HTTPS profile): https://localhost:5123
# The backend routes are under /api/v1 (API versioned), so the base URL includes the prefix.
VITE_API_URL=https://localhost:5123/api/v1

# Cloudflare Turnstile anti-bot challenge. Requires a hostname you control, so
# it stays disabled until a domain is purchased. Re-enable by setting this to
# 'true' AND flipping the backend's Turnstile:Enabled secret to true, and by
# setting Turnstile:ExpectedHostname to the real domain. The two must agree: the
# backend skip-switch makes verification pass when disabled, so a visible
# widget would be a challenge whose result is ignored.
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
